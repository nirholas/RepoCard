{
  "name": "repocard",
  "version": "1.0.0",
  "private": true,
  "description": "AI-designed social preview images for your GitHub repos. Reads your README, designs unique cards, renders crisp PNGs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/RepoCard.git"
  },
  "homepage": "https://github.com/nirholas/RepoCard#readme",
  "bugs": {
    "url": "https://github.com/nirholas/RepoCard/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "tsx scripts/preview.ts",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "cf-typegen": "wrangler types",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@cf-wasm/satori": "^0.4.2",
    "@resvg/resvg-wasm": "^2.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
