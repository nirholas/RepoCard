{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repocard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // Rendering takes roughly 50-300 ms of CPU, so RepoCard needs the Workers
  // Paid plan (the Free plan allows 10 ms of CPU per request).
  "limits": { "cpu_ms": 10000 },

  // The web UI in public/ is served as static assets; these paths go to the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/card/*", "/api/*", "/mcp", "/openapi.json", "/llms.txt", "/health"]
  },

  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": false }],

  // Workers AI designs the cards. Remove to use deterministic designs only.
  "ai": { "binding": "AI" },

  // Stores generated designs so each repository keeps a stable look.
  // Create with `npx wrangler kv namespace create DESIGNS` and paste the id here.
  "kv_namespaces": [{ "binding": "DESIGNS", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }],

  "ratelimits": [
    { "name": "RENDER_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
    { "name": "AI_LIMITER", "namespace_id": "4202", "simple": { "limit": 10, "period": 60 } }
  ],

  "vars": {
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }

  // Secrets (never commit these):
  //   npx wrangler secret put GITHUB_TOKEN   strongly recommended: 5,000 GitHub API requests/hour instead of 60
  //   npx wrangler secret put LLM_API_KEY    only with AI_PROVIDER=openai-compatible
}
